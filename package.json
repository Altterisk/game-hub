{
  "name": "@altterisk/game-hub",
  "version": "0.6.2",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "Shared shell, design tokens and cross-site building blocks for the altterisk.cc game sites",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./chakra": {
      "types": "./dist/chakra.d.ts",
      "default": "./dist/chakra.js"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "default": "./dist/codec.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "default": "./dist/data.js"
    },
    "./persist": {
      "types": "./dist/persist.d.ts",
      "default": "./dist/persist.js"
    },
    "./filters": {
      "types": "./dist/filters.d.ts",
      "default": "./dist/filters.js"
    },
    "./archive": {
      "types": "./dist/archive.d.ts",
      "default": "./dist/archive.js"
    },
    "./spine": {
      "types": "./dist/spine.d.ts",
      "default": "./dist/spine.js"
    },
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "default": "./dist/viewer.js"
    },
    "./meta": {
      "types": "./dist/meta.d.ts",
      "default": "./dist/meta.js"
    },
    "./meta/dom": {
      "types": "./dist/metaDom.d.ts",
      "default": "./dist/metaDom.js"
    },
    "./meta/next": {
      "types": "./dist/metaNext.d.ts",
      "default": "./dist/metaNext.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./time": {
      "types": "./dist/time.d.ts",
      "default": "./dist/time.js"
    },
    "./audio": {
      "types": "./dist/audio.d.ts",
      "default": "./dist/audio.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "default": "./dist/text.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./ui.css": "./styles/ui.css",
    "./ui-reset.css": "./styles/ui-reset.css",
    "./hub.css": "./styles/hub.css",
    "./base.css": "./styles/base.css",
    "./components.css": "./styles/components.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build:lib": "tsc -p tsconfig.lib.json",
    "gen:ui": "node scripts/gen-ui.mjs",
    "prepare": "npm run build:lib",
    "dev": "vite",
    "build": "npm run build:lib && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "brotli-dec-wasm": "^2.3.2",
    "react": ">=18",
    "react-dom": ">=18",
    "@chakra-ui/react": "^2.5.5"
  },
  "devDependencies": {
    "@chakra-ui/react": "^2.5.5",
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "brotli-dec-wasm": "^2.3.2",
    "framer-motion": "^10.11.2",
    "jsdom": "^25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "peerDependenciesMeta": {
    "brotli-dec-wasm": {
      "optional": true
    },
    "@chakra-ui/react": {
      "optional": true
    }
  }
}
