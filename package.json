{
  "name": "@altterisk/game-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared top bar, game switcher, footer and design tokens for the altterisk.cc game sites",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./chakra": { "types": "./dist/chakra.d.ts", "default": "./dist/chakra.js" },
    "./hub.css": "./styles/hub.css",
    "./base.css": "./styles/base.css",
    "./components.css": "./styles/components.css"
  },
  "files": ["dist", "styles"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build:lib": "tsc -p tsconfig.lib.json",
    "prepare": "npm run build:lib",
    "dev": "vite",
    "build": "npm run build:lib && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
